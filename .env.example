# Environment Variables — drnorfaizal-hugo
# Copy this to .env and fill in your actual values
# Never commit .env to GitHub

# Gemini (new_insight.py, translate_*.py, ai-compose.js, ai-curate.js, atomise.js)
GEMINI_API_KEY=your_gemini_api_key

# Notion (ai-compose.js, ai-curate.js, atomise.js)
NOTION_API_KEY=your_notion_integration_key
NOTION_CURATOR_PAGE_ID=your_notion_page_id
NOTION_RAW_IDEAS_DB_ID=your_raw_ideas_database_id

# IndexNow (indexnow_submit.py — key file lives in static/)
INDEXNOW_KEY=your_indexnow_key
